# Google Cloud OAuth client for the Gmail API (Desktop app type — required,
# because Google's device flow does not support Gmail scopes).
# Create it at console.cloud.google.com -> Credentials -> OAuth client ID.
# Loopback redirects (http://127.0.0.1:8765/) work automatically for Desktop
# clients — no redirect URI registration is needed.
GMAIL_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# The client secret from the console. Optional for the flow (PKCE is used),
# but recommended.
# GMAIL_CLIENT_SECRET=

# Optional: where the token cache is stored (default: ~/.gmail-mcp)
# GMAIL_TOKEN_DIR=~/.gmail-mcp

# Optional: local port for the OAuth loopback callback (default: 8765)
# GMAIL_AUTH_PORT=8765

# Optional: set to 1 to enable the full-access scope (https://mail.google.com/)
# which allows permanent_delete_email. Requires a sensitive-scope consent.
# GMAIL_FULL_ACCESS=0

# Optional: MCP transport when --transport is not passed (stdio, http, sse, streamable-http)
# GMAIL_TRANSPORT=stdio
